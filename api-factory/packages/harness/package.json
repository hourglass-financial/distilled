{
  "name": "@hourglass-financial/api-factory-harness",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/hourglass-financial/distilled",
    "directory": "api-factory/packages/harness"
  },
  "type": "module",
  "sideEffects": false,
  "module": "src/index.ts",
  "files": [
    "lib",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./probe": {
      "types": "./lib/probe.d.ts",
      "bun": "./src/probe.ts",
      "default": "./lib/probe.js"
    },
    "./reporter": {
      "types": "./lib/coverage/reporter.d.ts",
      "bun": "./src/coverage/reporter.ts",
      "default": "./lib/coverage/reporter.js"
    }
  },
  "scripts": {
    "typecheck": "tsc && tsc -p tsconfig.test.json",
    "build": "tsc -b",
    "fmt": "oxfmt --write src test",
    "lint": "oxlint --fix src test",
    "check": "bun run typecheck && oxlint src test && oxfmt --check src test",
    "test": "bunx vitest run test"
  },
  "dependencies": {
    "@hourglass-financial/api-factory-core": "workspace:*"
  },
  "peerDependencies": {
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  }
}
