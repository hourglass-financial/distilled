{
  "openapi": "3.1.0",
  "info": {
    "title": "Composed request body fixture",
    "version": "1.0.0"
  },
  "paths": {
    "/memberships/{id}": {
      "put": {
        "operationId": "updateMembership",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleSelection"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated membership",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/memberships": {
      "post": {
        "operationId": "createMembership",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "type": "object",
                    "properties": {
                      "user_id": { "type": "string" },
                      "organization_id": { "type": "string" }
                    },
                    "required": ["user_id", "organization_id"]
                  },
                  { "$ref": "#/components/schemas/RoleSelection" }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created membership",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RoleSelection": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "actor_id": { "type": "string" }
            },
            "required": ["actor_id"],
            "not": {
              "anyOf": [
                { "required": ["role_slug"] },
                { "required": ["role_slugs"] }
              ]
            }
          },
          {
            "type": "object",
            "properties": {
              "actor_id": { "type": "string" },
              "role_slug": { "type": "string" },
              "client_secret": {
                "type": "string",
                "description": "Secret accepted by the singular role variant"
              }
            },
            "required": ["actor_id", "role_slug"],
            "not": { "required": ["role_slugs"] }
          },
          {
            "type": "object",
            "properties": {
              "actor_id": { "type": "string" },
              "role_slugs": {
                "type": "array",
                "items": { "type": "string" }
              },
              "client_secret": {
                "type": "string",
                "description": "Secret accepted by the plural role variant"
              }
            },
            "required": ["actor_id", "role_slugs"],
            "not": { "required": ["role_slug"] }
          }
        ]
      }
    }
  }
}
