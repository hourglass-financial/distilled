            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": { "type": "string", "enum": ["string"] },
              "value": { "type": ["string", "null"] }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
