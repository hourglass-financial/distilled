              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": { "type": "string", "enum": ["selfie"] },
              "value": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": ["id", "type"],
                "properties": {
                  "id": { "type": "string" },
                  "type": {
                    "type": "string",
                    "enum": ["Selfie::ProfileAndCenter"]
