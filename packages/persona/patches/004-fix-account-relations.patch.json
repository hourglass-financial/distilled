{
  "description": "Restore the documented cursor pagination input on the Account relations endpoint and keep its polymorphic JSON:API resources runtime-decodable. Persona's full account/transaction component expansion exceeds the shared bounded-inline-union limit, so this operation retains the verified type/id discriminants and preserves all provider-defined resource members as additional properties.",
  "patches": [
    {
      "op": "add",
      "path": "/paths/~1accounts~1{accountId}~1relations/get/parameters/-",
      "value": {
        "$ref": "#/components/parameters/pagination-query-params"
      }
    },
    {
      "op": "replace",
      "path": "/paths/~1accounts~1{accountId}~1relations/get/responses/200/content/application~1json/schema/properties/data/items/oneOf/0",
      "value": {
        "type": "object",
        "additionalProperties": true,
        "required": ["type", "id"],
        "properties": {
          "type": { "type": "string", "const": "account" },
          "id": { "type": "string" }
        }
      }
    },
    {
      "op": "replace",
      "path": "/paths/~1accounts~1{accountId}~1relations/get/responses/200/content/application~1json/schema/properties/data/items/oneOf/1",
      "value": {
        "type": "object",
        "additionalProperties": true,
        "required": ["type", "id"],
        "properties": {
          "type": { "type": "string", "const": "transaction" },
          "id": { "type": "string" }
        }
      }
    }
  ]
}
